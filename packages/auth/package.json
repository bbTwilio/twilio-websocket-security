{
  "name": "@twilio-samples/relay-auth",
  "version": "1.0.0",
  "description": "Handshake authentication for Twilio ConversationRelay and Media Streams WebSockets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
