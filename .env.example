# Copy to .env for local development. Never commit the real file.
# In production, load all of these from Secret Manager / Secrets Manager /
# Key Vault rather than plaintext environment variables.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Host only, NO scheme, no trailing slash. Must match the wss:// host in your
# TwiML exactly, because the host is part of what Twilio signs.
# Configured deliberately -- never derived from the inbound Host header, which
# is attacker-controlled.
PUBLIC_HOST=relay.example.com

# Twilio Console > Account > API keys & tokens
TWILIO_AUTH_TOKEN=your_auth_token_here

# Key for connection tokens. Yours, not Twilio's -- so you can rotate it
# independently, and a leaked Twilio auth token does not also let someone mint
# connection tokens. Must decode to >= 32 bytes.
#   openssl rand -base64 32
RELAY_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set ONLY during an auth-token rotation. Twilio signs with whichever token is
# current, so validating against just one will drop live calls mid-rotation.
# Remove it once the rotation is complete.
TWILIO_AUTH_TOKEN_SECONDARY=

# Shared store for single-use token enforcement. WITHOUT THIS, replay protection
# is per-instance only: a replayed token simply routes to another instance and
# succeeds. Required for any multi-instance deployment.
REDIS_URL=

# Adds a Twilio REST lookup per connection to confirm the call exists, is live,
# and belongs to your account. Costs a round trip; worth it for regulated flows.
VERIFY_CALL_EXISTS=false
TWILIO_ACCOUNT_SID=

# Token lifetime. Long enough to cover TwiML delivery plus Twilio dialling your
# socket; short enough that a leaked token is near-worthless. 90s is a good
# default -- raise it only if you see 'expired' denials on healthy calls.
RELAY_TOKEN_TTL_SECONDS=90

# Path of the WebSocket endpoint.
WS_PATH=/ws

# Ping interval. Must stay below your edge's idle timeout: Azure Front Door
# idles at 5 minutes, AWS API Gateway at 10, and a caller on hold sends nothing.
KEEPALIVE_INTERVAL_MS=25000

# Drop a socket that never sends its `setup` frame.
SETUP_TIMEOUT_MS=10000

# Cap on concurrent sockets per instance; excess handshakes get a 503.
MAX_CONCURRENT_SOCKETS=500
